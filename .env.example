# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret used to sign session tokens for email/password auth.
JWT_SECRET="CHANGE_ME_SESSION_SECRET"

# ADMIN_EMAIL: Optional initial administrator email for Firebase Google Sign-In.
ADMIN_EMAIL=""

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key.
VITE_GOOGLE_MAPS_API_KEY=""
